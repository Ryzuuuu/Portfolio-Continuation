# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable is optional: the API boots without any of them and logs a
# warning for whatever is missing.

# ─── Server ──────────────────────────────────────────────────────────────
# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=5000

# Comma-separated browser origins allowed to call the API (CORS allow-list).
# Unset = only the local Vite dev (5173) and preview (4173) servers.
# Production example: https://yourdomain.com,https://www.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Set this when the API runs behind a reverse proxy or load balancer (Render,
# Railway, Fly.io, Nginx...) so the rate limiter sees each visitor's real IP
# instead of the proxy's. Use the number of proxies in front of the app,
# usually 1. Default: off.
# TRUST_PROXY=1

# ─── MongoDB (optional) ──────────────────────────────────────────────────
# A durable backup copy of every message. Leave empty to run email-only;
# if it's set but unreachable, mail still goes out and the API retries
# the connection every 30 seconds.
# MONGODB_URI=mongodb://127.0.0.1:27017/manga-portfolio
MONGODB_URI=

# ─── Frontend (build time) ───────────────────────────────────────────────
# Only needed when the API is hosted on a different origin than the site.
# Vite bakes it into the bundle at build time; it is not a secret.
# VITE_API_BASE_URL=https://api.yourdomain.com

# Public Web3Forms access key used directly by the browser for email delivery.
# This key is intentionally included in the frontend bundle; Web3Forms expects
# client-side submissions. Configure it as a Cloudflare Pages build variable.
# VITE_WEB3FORMS_ACCESS_KEY=
